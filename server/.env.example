# ===== Douyin Fire 环境变量示例 =====
# 复制为 .env 并填写；不填则使用 start.bat / setup.sh 里的默认值。

# --- 部署模式（核心开关）---
# local = 免登录本地模式（默认永久会员，推荐本地/独立部署）
# server = 账号登录模式（服务器/公网部署，默认）
# DEPLOY_MODE=local

# --- 服务监听 ---
# GUI_HOST=127.0.0.1
# GUI_PORT=8765

# --- 管理员账号（server 模式必须；local 模式保留备用）---
# ADMIN_USER=admin
# ADMIN_PASSWORD=admin

# --- 邮件服务（注册 / 找回密码 的邮箱验证码，可选）---
# RESEND_API_KEY=
# MAIL_FROM=

# --- 抖音登录态（可选；也可在后台【个人中心】扫码/粘贴 Cookie）---
# DOUYIN_COOKIE=
# DOUYIN_STORAGE_STATE=

# --- 运行参数（可选）---
# HEADLESS=true
# BROWSER_PATH=
# TRACE=true

# --- 钉钉机器人通知（可选，两者需同时配置）---
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
